{
  "id": "notifications",
  "name": "Notifications",
  "description": "Persistent Mission Control notification inbox and delivery events",
  "version": "0.2.0",
  "enabled": true,
  "routePath": "/notifications",
  "navItem": {
    "to": "/notifications",
    "label": "Notifications",
    "icon": "Bell",
    "order": 55
  },
  "surfaces": {
    "overview": {
      "enabled": true,
      "order": 20,
      "className": "widget-notifications"
    },
    "attention": {
      "enabled": true,
      "order": 20
    }
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/notifications",
      "handler": "listNotifications",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/notifications/publish",
      "handler": "publishNotification",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/notifications/deliveries",
      "handler": "listDeliveries",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/notifications/deliveries/queue",
      "handler": "queueDelivery",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/notifications/deliveries/claim",
      "handler": "claimDeliveries",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/notifications/deliveries/complete",
      "handler": "completeDelivery",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/notifications/deliveries/fail",
      "handler": "failDelivery",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/notifications/read",
      "handler": "markNotificationRead",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/notifications/read-all",
      "handler": "markAllNotificationsRead",
      "authRequired": true
    }
  ]
}
